#!/command/execlineb -P
with-contenv
define user epgd
define group epgd
backtick -E uid { id -u ${user} }
backtick -E gid {
 pipeline { getent group ${group} }
 s6-cut -d ":" -f 3
}
importas -D "911" puid PUID
importas -D "911" pgid PGID
foreground {
 if { eltest ${uid} -ne ${puid} }
  foreground { s6-echo "Change the user ID of user ${user} to ${puid}" }
  foreground { usermod --non-unique --uid "${puid}" "${user}" }
  if -n { redirfd -w 2 /dev/null find / -user "${uid}" -not -path "/proc/*" -exec chown -h "${user}" {} \; }
   s6-true
}
foreground {
 if { eltest ${gid} -ne ${pgid} }
  foreground { s6-echo "Change the group ID of group ${group} to ${pgid}" }
  foreground { groupmod --non-unique --gid "${pgid}" "${group}" }
  if -n { redirfd -w 2 /dev/null find / -group "${gid}" -not -path "/proc/*" -exec chgrp -h "${group}" {} \; }
   s6-true
}
elglob -0s dri_devs "/dev/dri/renderD*"
elglob -0s card_devs "/dev/dri/card*"
forx -E dev { ${dri_devs} ${card_devs} }
 backtick -E dev_gid { stat -c "%g" "${dev}" }
 if -t { eltest "${dev_gid}" -gt 0 }
 backtick -E user_gids { id -G "${user}" }
 if -nt { eltest " ${user_gids} " =~ " ${dev_gid} " }
 backtick -D "" -E grp {
  pipeline { getent group "${dev_gid}" }
  s6-cut -d ":" -f 1
 }
 backtick -E target {
  ifelse { eltest -n "${grp}" }
   { s6-echo "${grp}" }
   foreground { redirfd -w 1 /dev/null groupadd -g "${dev_gid}" "dri-${dev_gid}" }
   s6-echo "dri-${dev_gid}"
 }
 foreground { s6-echo "Add user ${user} to group ${target} (GID ${dev_gid})" }
 usermod -aG "${target}" "${user}"
