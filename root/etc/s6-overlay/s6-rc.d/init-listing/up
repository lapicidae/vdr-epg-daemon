#!/command/execlineb -P
with-contenv
define user epgd
define group epgd
backtick -E uid { id -u ${user} }
backtick -E gid {
 pipeline { getent group ${group} }
 s6-cut -d ":" -f 3
}
backtick -E -D "NONE" tz { realpath --relative-to /usr/share/zoneinfo /etc/localtime }
importas -D "" lang LANG
importas -D "" language LANGUAGE

foreground { s6-echo "┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄⚟ Settings ⚞┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄" }
foreground {
 printf "%-26s%s (%s)\\n"
  "User ID:"  "${uid}"  "${user}"
  "Group ID:" "${gid}"  "${group}"
}
foreground {
 printf "%-26s%s\\n"
  "Lang:"     "${lang}"
  "Language:" "${language}"
  "Timezone:" "${tz}"
}
foreground {
 forx -E entry {
  "FFMPEG=FFmpeg support:"
  "LOGO_INTERNAL=Internal logos:"
  "LOGO_OVERWRITE=Overwrite existing logos:"
  "START_EPGHTTPD=Enable webinterface:"
  "RESTART_EPGD=Restart EPGd:"
  "RESTART_EPGD_AT=Restart EPGd at:"
  "LOG2FILE=Log2File:"
 }
 multidefine -d "=" "${entry}" { var label }
 if -t { eltest -v "${var}" }
  importas -D "" val "${var}"
  printf "%-26s%s\\n" "${label}" "${val}"
}
s6-echo "┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄"
